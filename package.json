{
  "name": "slopzap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "eval": "tsx evaluation/run.ts",
    "eval:corpus": "tsx evaluation/corpus-cli.ts evaluate",
    "train": "tsx evaluation/corpus-cli.ts train",
    "benchmark": "node scripts/benchmark.mjs",
    "reproducibility": "node scripts/reproducibility.mjs",
    "release:check": "tsx scripts/release-check.ts",
    "model:probe": "node scripts/probe-model.mjs",
    "live:smoke": "tsx scripts/live-smoke.ts",
    "toolbar:smoke": "node scripts/toolbar-smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && node scripts/check-build.mjs",
    "postinstall": "wxt prepare"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
